# Relay - copy this file to .env and fill in ONE provider key.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Everything works without a key: the app falls back to rule-based intent
# parsing and extractive summaries.

# ---- LLM provider -----------------------------------------------------------
# auto | gemini | openai | none
#   auto   -> gemini if GEMINI_API_KEY is set, else openai if OPENAI_API_KEY is
#             set, else none.
#   openai -> any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama...).
#   none   -> force the no-LLM fallback.
LLM_PROVIDER=auto

# ---- Google Gemini (free key: https://aistudio.google.com/apikey) -----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- OpenAI-compatible API --------------------------------------------------
# Groq example (free key: https://console.groq.com/keys):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   LLM_REASONING_EFFORT=low
# OpenAI example:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# low | medium | high | (empty = off). Only for reasoning models, e.g. Groq GPT-OSS.
LLM_REASONING_EFFORT=
# Request timeout for a single LLM call, in seconds.
LLM_TIMEOUT_S=45

# ---- Crawler ----------------------------------------------------------------
# auto | crawl4ai | sitecrawl
CRAWLER=auto
# Fall back to sitecrawl if Crawl4AI crashes or returns unusable output. 1 = on.
CRAWL4AI_FALLBACK=1

# ---- Limits -----------------------------------------------------------------
CRAWL_DEFAULT_PAGES=5
CRAWL_MAX_PAGES=20
CRAWL_DEFAULT_DEPTH=1
CRAWL_MAX_DEPTH=2
# Wall-clock limit for a spawned CLI process, in seconds.
PROCESS_TIMEOUT_S=90
MAX_CONCURRENT_JOBS=3
MAX_PROMPT_CHARS=2000
# Skip the intent LLM call for unambiguous requests (~1 s faster). 1 = on.
INTENT_FAST_PATH=0

# ---- Local testing only -----------------------------------------------------
# Allows crawling 127.0.0.1 / private addresses. NEVER enable in production.
ALLOW_PRIVATE_HOSTS=0

# Where run evidence (command, logs, JSON) is written. Defaults to ./runs.
# RUNS_DIR=/tmp/runs
